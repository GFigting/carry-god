{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CG Harness Task",
  "type": "object",
  "required": ["id", "type", "title", "status", "acceptance", "evidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^TASK-[A-Za-z0-9._-]+$" },
    "type": { "enum": ["work", "fix", "refactor", "optimize", "prototype", "review"] },
    "title": { "type": "string", "minLength": 1 },
    "intent": { "type": "string" },
    "source": { "type": "string" },
    "confidence": { "enum": ["high", "medium", "low"] },
    "project": { "type": "string" },
    "goal": { "type": "string" },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "decisions": { "type": "array" },
    "artifacts": { "type": "array" },
    "context_package": { "type": "string" },
    "parent_task": { "type": ["string", "null"] },
    "subtasks": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "plan_steps": { "type": "array" },
    "learnings": { "type": "array" },
    "intake": { "type": "object" },
    "scope": { "type": "object" },
    "preserve": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array" },
    "risks": { "type": "array" },
    "findings": { "type": "array" },
    "residual_risk_declared": { "type": "boolean" },
    "status": { "enum": ["draft", "ready", "in_progress", "under_review", "blocked", "revision", "done", "cancelled", "archived"] },
    "acceptance": { "type": "array", "items": { "type": "object", "required": ["id", "text"] } },
    "evidence": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "acceptance", "result"] } }
  }
}
